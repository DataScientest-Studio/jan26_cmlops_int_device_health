# =============================================================================
# CLOUD DEPLOYMENT MODE CONFIGURATION
# =============================================================================
# This file is GIT-TRACKED. Do NOT put secrets here.
# Secrets (DAGSHUB_TOKEN, DB_PASSWORD, etc.) go in .env.secrets (gitignored).
#
# Usage:  make cloud
# Effect: MLflow and DVC point to DagsHub (cloud).
#         All compute (API, Airflow, Prometheus, Grafana) still runs locally
#         in Docker containers. No local MLflow container is started.
# =============================================================================

# ── Deployment Identity ───────────────────────────────────────────────────────
DEPLOYMENT_MODE=cloud

# ── MLflow ───────────────────────────────────────────────────────────────────
# Local-first architecture: primary server is mlops_mlflow_buffer (local Docker).
# DagsHub is only written by the scheduled sync_mlflow_to_dagshub Airflow DAG.
#
# MLFLOW_TRACKING_URI here is for HOST processes (Streamlit via make ui).
# Docker containers use http://mlflow_buffer:5000 (set in docker-compose.cloud.yml).
MLFLOW_TRACKING_URI=http://localhost:5002
MLFLOW_BUFFER_PORT=5002

# FU-2: Sync DAG schedule control. Set to false and restart Airflow to enable auto sync.
MLFLOW_SYNC_PAUSED=true
MLFLOW_PORT=5001

# ── DVC ──────────────────────────────────────────────────────────────────────
# Cloud: DagsHub S3-compatible remote storage
DVC_REMOTE=dagshub
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are set to DagsHub credentials
# in .env.secrets (DagsHub uses AWS-compatible storage API)

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=mlops_prod
DB_USER=mlops_user
DB_HOST=postgres
DB_PORT=5433

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000
LOG_LEVEL=INFO

# ── Nginx ─────────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_PORT=8081
AIRFLOW_USER=admin

# ── Monitoring ────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
ALERTMANAGER_PORT=9093
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8082

# ── Model Registry ────────────────────────────────────────────────────────────
MODEL_REGISTRY_ENABLED=true
MODEL_REGISTRY_NAME=device_health_classifier_cloud
MODEL_REGISTRY_STAGE=Production
CHAMPION_PROMOTION_THRESHOLD=0.02
PRIMARY_METRIC=f1_score

# ── Training ──────────────────────────────────────────────────────────────────
SLIDING_WINDOW_DAYS=90
K_RANGE_MIN=2
K_RANGE_MAX=5
GIT_USER_NAME="Airflow Bot"
GIT_USER_EMAIL=airflow@mlops.local

# ── MLflow Buffer PostgreSQL (FU-1: dedicated PostgreSQL for MLflow buffer) ───
# Port 5434 on host; internal port always 5432 within Docker network.
MLFLOW_PG_PORT=5434
MLFLOW_PG_DB=mlops_mlflow
MLFLOW_PG_USER=mlflow_user
# MLFLOW_PG_PASSWORD should be set in .env.secrets for production.
# Default below is for development only.
MLFLOW_PG_PASSWORD=changeme_mlflow

# ── PostgreSQL Exporter ports (FU-PG-MONITOR) ────────────────────────────────
POSTGRES_EXPORTER_PORT=9187
POSTGRES_MLFLOW_EXPORTER_PORT=9188
