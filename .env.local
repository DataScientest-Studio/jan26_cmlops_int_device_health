# =============================================================================
# LOCAL DEPLOYMENT MODE CONFIGURATION
# =============================================================================
# This file is GIT-TRACKED. Do NOT put secrets here.
# Secrets (passwords, tokens) go in .env.secrets (gitignored).
#
# Usage:  make local
# Effect: All services run in local Docker containers.
#         MLflow runs as a local container (localhost:5001).
#         DVC remote points to local filesystem.
# =============================================================================

# ── Deployment Identity ───────────────────────────────────────────────────────
DEPLOYMENT_MODE=local

# ── MLflow ───────────────────────────────────────────────────────────────────
# Local: MLflow container accessible from the HOST via published port.
# Inside Docker containers (api, api_challenger) docker-compose.local.yml
# overrides this with http://mlflow:5000 (Docker-internal hostname).
MLFLOW_TRACKING_URI=http://localhost:5001
# macOS AirPlay Receiver occupies 5000; use 5001 on this machine
MLFLOW_PORT=5001
# Credentials are empty for local mode (no auth on local MLflow)
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# ── DVC ──────────────────────────────────────────────────────────────────────
# Local: DVC uses local filesystem cache
DVC_REMOTE=local
# DagsHub credentials intentionally empty in local mode
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=mlops_local
DB_USER=mlops_user
DB_HOST=postgres
DB_PORT=5433

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000
LOG_LEVEL=INFO

# ── Nginx ─────────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_PORT=8081
AIRFLOW_USER=admin

# ── Monitoring ────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
ALERTMANAGER_PORT=9093
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8082

# ── Model Registry ────────────────────────────────────────────────────────────
MODEL_REGISTRY_ENABLED=true
MODEL_REGISTRY_NAME=device_health_classifier_local
MODEL_REGISTRY_STAGE=Production
CHAMPION_PROMOTION_THRESHOLD=0.02
PRIMARY_METRIC=f1_score

# ── Training ──────────────────────────────────────────────────────────────────
SLIDING_WINDOW_DAYS=90
K_RANGE_MIN=2
K_RANGE_MAX=5
