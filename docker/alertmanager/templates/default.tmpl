{{ define "email.html" }}
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
    }
    .header {
      background-color: #f4f4f4;
      padding: 20px;
      border-left: 5px solid #007bff;
      margin-bottom: 20px;
    }
    .header.critical {
      border-left-color: #dc3545;
      background-color: #f8d7da;
    }
    .header.warning {
      border-left-color: #ffc107;
      background-color: #fff3cd;
    }
    .header.info {
      border-left-color: #17a2b8;
      background-color: #d1ecf1;
    }
    .alert-card {
      border: 1px solid #ddd;
      border-radius: 4px;
      padding: 15px;
      margin-bottom: 15px;
      background-color: #fff;
    }
    .alert-title {
      font-size: 18px;
      font-weight: bold;
      margin-bottom: 10px;
      color: #007bff;
    }
    .alert-title.critical {
      color: #dc3545;
    }
    .alert-title.warning {
      color: #ffc107;
    }
    .alert-description {
      margin: 10px 0;
    }
    .alert-labels {
      background-color: #f8f9fa;
      padding: 10px;
      border-radius: 4px;
      font-size: 14px;
      margin-top: 10px;
    }
    .alert-labels span {
      display: inline-block;
      background-color: #007bff;
      color: white;
      padding: 3px 8px;
      border-radius: 3px;
      margin: 2px;
      font-size: 12px;
    }
    .runbook-link {
      display: inline-block;
      background-color: #28a745;
      color: white;
      padding: 8px 15px;
      text-decoration: none;
      border-radius: 4px;
      margin-top: 10px;
    }
    .runbook-link:hover {
      background-color: #218838;
    }
    .footer {
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid #ddd;
      font-size: 12px;
      color: #666;
    }
    .status-firing {
      color: #dc3545;
      font-weight: bold;
    }
    .status-resolved {
      color: #28a745;
      font-weight: bold;
    }
    .timestamp {
      color: #666;
      font-size: 14px;
    }
  </style>
</head>
<body>
  {{ $severity := "" }}
  {{ range .Alerts }}
    {{ if eq .Labels.severity "critical" }}
      {{ $severity = "critical" }}
    {{ else if eq .Labels.severity "warning" }}
      {{ $severity = "warning" }}
    {{ else }}
      {{ $severity = "info" }}
    {{ end }}
  {{ end }}

  <div class="header {{ $severity }}">
    <h1>
      {{ if eq $severity "critical" }}🚨{{ else if eq $severity "warning" }}⚠️{{ else }}ℹ️{{ end }}
      MLOps Alert: {{ .GroupLabels.alertname }}
    </h1>
    <p>
      <strong>Severity:</strong> {{ .GroupLabels.severity | toUpper }}<br>
      <strong>Component:</strong> {{ .GroupLabels.component }}<br>
      <strong>Environment:</strong> {{ .ExternalLabels.environment }}
    </p>
  </div>

  <h2>Alert Details</h2>

  {{ range .Alerts }}
  <div class="alert-card">
    <div class="alert-title {{ .Labels.severity }}">
      {{ .Annotations.summary }}
    </div>
    
    <div class="alert-description">
      <strong>Description:</strong> {{ .Annotations.description }}
    </div>
    
    <div class="timestamp">
      <strong>Status:</strong> 
      {{ if eq .Status "firing" }}
        <span class="status-firing">🔥 FIRING</span>
      {{ else }}
        <span class="status-resolved">✅ RESOLVED</span>
      {{ end }}
      <br>
      <strong>Started:</strong> {{ .StartsAt.Format "2006-01-02 15:04:05 MST" }}<br>
      {{ if ne .EndsAt.Unix 0 }}
        <strong>Ended:</strong> {{ .EndsAt.Format "2006-01-02 15:04:05 MST" }}<br>
      {{ end }}
    </div>

    <div class="alert-labels">
      <strong>Labels:</strong><br>
      {{ range .Labels.SortedPairs }}
        <span>{{ .Name }}: {{ .Value }}</span>
      {{ end }}
    </div>

    {{ if .Annotations.runbook_url }}
    <a href="{{ .Annotations.runbook_url }}" class="runbook-link">📖 View Runbook</a>
    {{ end }}
  </div>
  {{ end }}

  <div class="footer">
    <p>
      <strong>Alertmanager:</strong> {{ .ExternalURL }}<br>
      <strong>Project:</strong> {{ .ExternalLabels.project }}
    </p>
    <p>
      This is an automated alert from the MLOps Device Health Monitoring System.
      For more information, visit the <a href="http://localhost:3000">Grafana Dashboard</a> 
      or <a href="http://localhost:9090">Prometheus</a>.
    </p>
  </div>
</body>
</html>
{{ end }}

{{ define "slack.title" }}
{{ if eq .Status "firing" }}🔥{{ else }}✅{{ end }} {{ .GroupLabels.alertname }}
{{ end }}

{{ define "slack.text" }}
*Severity:* {{ .GroupLabels.severity | toUpper }}
*Component:* {{ .GroupLabels.component }}

{{ range .Alerts }}
• {{ .Annotations.summary }}
  {{ if .Annotations.description }}_{{ .Annotations.description }}_{{ end }}
{{ end }}

{{ if .ExternalURL }}
<{{ .ExternalURL }}|View in Alertmanager>
{{ end }}
{{ end }}
