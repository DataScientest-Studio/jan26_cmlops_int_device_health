# =============================================================================
# SECRETS TEMPLATE - COPY TO .env.secrets AND FILL IN YOUR VALUES
# =============================================================================
# .env.secrets is GITIGNORED and will NEVER be committed to version control.
# This template (.env.secrets.example) IS git-tracked as documentation.
#
# SETUP (one time only):
#   cp .env.secrets.example .env.secrets
#   # Then edit .env.secrets with your real values
#
# These values are combined with .env.local or .env.cloud at runtime:
#   make local   → loads .env.local  + .env.secrets
#   make cloud   → loads .env.cloud  + .env.secrets
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme_strong_password_here

# ── API Authentication ────────────────────────────────────────────────────────
# The API requires either OAuth2 JWT tokens (/auth/token) or an API key passed
# in the  X-API-Key  HTTP header on every prediction/metrics request.
#
# Development key (pre-configured in src/api/security.py):
#   X-API-Key: dev-key-12345        → scopes: read, write
#   X-API-Key: monitoring-key-67890 → scopes: read only
#
# OAuth2 credentials (pre-configured in src/api/auth.py):
#   username: admin    password: secret  → full admin access
#   username: user     password: secret  → read-only access
#
# In production, replace fake_api_keys_db and fake_users_db with real
# PostgreSQL-backed lookups and pass a strong SECRET_KEY via the env var:
API_SECRET_KEY=changeme_jwt_secret_min_32_chars_here

# ── DagsHub (required for cloud mode; optional for local mode) ────────────────
# Get your token: https://dagshub.com/user/settings/tokens
DAGSHUB_USER=your_dagshub_username
DAGSHUB_TOKEN=your_dagshub_token_here
DAGSHUB_REPO=mlops-device-health

# DagsHub uses AWS-compatible storage API. These map to your DagsHub credentials:
AWS_ACCESS_KEY_ID=your_dagshub_username
AWS_SECRET_ACCESS_KEY=your_dagshub_token_here

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_PASSWORD=changeme_strong_password_here
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=changeme_fernet_key_min_32_chars_long_example
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=changeme_secret_key_min_32_chars_long_example

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=changeme_grafana_password

# ── Alertmanager ─────────────────────────────────────────────────────────────
ALERT_EMAIL_FROM=alertmanager@mlops.local
ALERT_SMTP_HOST=smtp.gmail.com:587
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_TEAM_EMAIL=mlops-team@example.com
ALERT_CRITICAL_EMAIL=mlops-oncall@example.com
ALERT_API_TEAM_EMAIL=api-team@example.com
ALERT_ML_TEAM_EMAIL=ml-team@example.com
ALERT_DEVOPS_TEAM_EMAIL=devops-team@example.com
ALERT_SLACK_WEBHOOK_URL=

# ── GitHub API (optional — enables Streamlit GitHub CI/CD dashboard) ────────
# Create a Personal Access Token at https://github.com/settings/tokens
# Required scopes: repo (read), workflow (read + write for triggers)
# Without this token, the dashboard shows local git info only.
GITHUB_TOKEN=
# Override repo owner/name if different from defaults
# GITHUB_OWNER=your-github-username
# GITHUB_REPO=mlops-device-health
