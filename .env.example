# =============================================================================
# MLOps Device Health - Environment Configuration Template
# =============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control
# =============================================================================

# Database Configuration
DB_NAME=mlops_db
DB_USER=mlops_user
DB_PASSWORD=changeme_strong_password
DB_HOST=localhost
DB_PORT=5433
DATABASE_URL=postgresql://mlops_user:changeme_strong_password@localhost:5433/mlops_db

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_PORT=5001

# MLflow Remote Tracking (Phase 4 Week 6 - DagsHub)
# Uncomment these lines to use DagsHub for MLflow tracking instead of local
# MLFLOW_TRACKING_URI=https://dagshub.com/YOUR_USERNAME/YOUR_REPO.mlflow
# MLFLOW_TRACKING_USERNAME=${DAGSHUB_USER}
# MLFLOW_TRACKING_PASSWORD=${DAGSHUB_TOKEN}
# AWS_ACCESS_KEY_ID=${DAGSHUB_USER}  # DagsHub uses these for S3-compatible storage
# AWS_SECRET_ACCESS_KEY=${DAGSHUB_TOKEN}

# API Configuration
API_PORT=8000
LOG_LEVEL=INFO

# Deployment Mode (Phase 4 Week 8)
# Controls which MLflow backend and DVC remote are active.
# Use 'make local' or 'make cloud' instead of editing this directly.
# See: doc/DEPLOYMENT_MODES.md and .env.local / .env.cloud
DEPLOYMENT_MODE=local   # 'local' = all services in Docker | 'cloud' = DagsHub MLflow + DVC

# Airflow Configuration
AIRFLOW_PORT=8080
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=changeme_strong_password
AIRFLOW_SECRET_KEY=changeme_secret_key_min_32_chars_long_example
AIRFLOW_FERNET_KEY=changeme_fernet_key_min_32_chars_long_example

# Nginx Configuration
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Model Configuration
MODEL_NAME=device_health_classifier
MODEL_REGISTRY_ENABLED=true  # Set to 'false' to use bootstrap model only
MODEL_REGISTRY_NAME=device_health_classifier  # MLflow Registry model name
MODEL_REGISTRY_STAGE=Production  # Model stage to load: Production or Staging
CHAMPION_PROMOTION_THRESHOLD=0.02
MODEL_VERSION=v1.0.0
PRIMARY_METRIC=f1_score

# Training Configuration
SLIDING_WINDOW_DAYS=90
K_RANGE_MIN=2
K_RANGE_MAX=5

# DVC Configuration (for remote storage)
# AWS S3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET=mlops-device-health

# DagsHub (recommended for this project - Phase 4 Week 6)
# Get credentials from: https://dagshub.com/user/settings/tokens
DAGSHUB_USER=your_username
DAGSHUB_TOKEN=your_token_here
DAGSHUB_REPO=mlops-device-health

# DagsHub URLs (auto-generated, do not edit)
# DVC Remote: https://dagshub.com/${DAGSHUB_USER}/${DAGSHUB_REPO}.dvc
# MLflow: https://dagshub.com/${DAGSHUB_USER}/${DAGSHUB_REPO}.mlflow
# Repository: https://dagshub.com/${DAGSHUB_USER}/${DAGSHUB_REPO}

# Monitoring Configuration (Phase 4)
PROMETHEUS_PORT=9090
NODE_EXPORTER_PORT=9100  # Host system metrics
CADVISOR_PORT=8080      # Container metrics (Note: Conflicts with Airflow if both running)
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin

# Alerting Configuration (Phase 4 Week 7)
ALERTMANAGER_PORT=9093

# Email Notifications
ALERT_EMAIL_FROM=alertmanager@mlops.local
ALERT_SMTP_HOST=smtp.gmail.com:587
ALERT_SMTP_USERNAME=your_email@gmail.com
ALERT_SMTP_PASSWORD=your_app_password_here

# Team Email Addresses
ALERT_TEAM_EMAIL=mlops-team@example.com
ALERT_CRITICAL_EMAIL=mlops-oncall@example.com
ALERT_API_TEAM_EMAIL=api-team@example.com
ALERT_ML_TEAM_EMAIL=ml-team@example.com
ALERT_DEVOPS_TEAM_EMAIL=devops-team@example.com

# Slack Integration (optional)
# Get webhook URL from: https://api.slack.com/messaging/webhooks
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Security
SECRET_KEY=your_secret_key_change_in_production
API_KEY=your_api_key_for_authenticated_endpoints

# Feature Extraction Parameters
SAVGOL_WINDOW_LENGTH=11
SAVGOL_POLYORDER=3
PEAK_PROMINENCE_THRESHOLD=0.5

# Training Parameters
TRAIN_TEST_SPLIT=0.2
RANDOM_STATE=42
LOGISTIC_REGRESSION_C=1.0
LOGISTIC_REGRESSION_PENALTY=l2

# Monitoring Thresholds
DRIFT_DETECTION_THRESHOLD=0.1
DRIFT_CHECK_INTERVAL_HOURS=24
MAX_PREDICTION_LATENCY_MS=100

# Airflow (Phase 4)
# AIRFLOW_HOME=./airflow
# AIRFLOW__CORE__EXECUTOR=LocalExecutor
# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://mlops:change_me_in_production@localhost:5432/airflow
