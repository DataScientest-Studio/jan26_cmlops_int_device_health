# =============================================================================
# KUBERNETES DEPLOYMENT MODE CONFIGURATION
# =============================================================================
# This file is GIT-TRACKED. Do NOT put secrets here.
# Secrets (passwords, tokens) go in .env.secrets (gitignored).
#
# Usage:  make k8s-up   (sets .current_mode=k8s automatically)
#         make ui       (detects k8s mode, loads this file)
#
# IMPORTANT: Services are only reachable from the host after running
#            make k8s-ports   (sets up kubectl port-forwards to localhost)
#
# Port-forward mappings set by make k8s-ports:
#   api        -> localhost:8000
#   mlflow     -> localhost:5000
#   postgres   -> localhost:5434  (avoids conflict with local PG on 5432 / Docker stack on 5433)
#   airflow    -> localhost:8080
#   grafana    -> localhost:3000
#   prometheus -> localhost:9090
#   nginx      -> localhost:8888
# =============================================================================

# ── Deployment Identity ───────────────────────────────────────────────────────
DEPLOYMENT_MODE=k8s
MLOPS_ENVIRONMENT=kubernetes

# ── MLflow ───────────────────────────────────────────────────────────────────
# K8s: MLflow accessible via kubectl port-forward (make k8s-ports)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=automated_retraining_k8s
MLFLOW_PORT=5000
# Credentials are empty for local K8s mode (no auth on local MLflow)
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# ── DVC ──────────────────────────────────────────────────────────────────────
DVC_REMOTE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# K8s DB name differs from local Docker (mlops_k8s vs mlops_local)
DB_NAME=mlops_k8s
DB_USER=mlops_user
POSTGRES_HOST=localhost
# Port 5434: avoids conflict with local PostgreSQL (5432) and Docker stack (5433)
DB_PORT=5434

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000
LOG_LEVEL=INFO

# ── Nginx ─────────────────────────────────────────────────────────────────────
# Nginx is accessible via port-forward on 8888 (not NodePort 30080 — NodePort
# is not reachable on Windows/Docker Desktop K8s due to WSL2 networking).
NGINX_HTTP_PORT=8888

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_PORT=8080
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=local_dev_password
# REST API URL used by batch_rescoring, retraining_pipeline, and model_promotion.
AIRFLOW_API_URL=http://localhost:8080
# REST API URL used by batch_rescoring, retraining_pipeline, and model_promotion use cases.

# ── Monitoring ────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin

# ── Model Registry ────────────────────────────────────────────────────────────
MODEL_REGISTRY_ENABLED=true
MODEL_REGISTRY_NAME=device_health_classifier_k8s
MODEL_REGISTRY_STAGE=Production
CHAMPION_PROMOTION_THRESHOLD=0.02
PRIMARY_METRIC=f1_score

# ── Training ──────────────────────────────────────────────────────────────────
SLIDING_WINDOW_DAYS=90
K_RANGE_MIN=2
K_RANGE_MAX=5
